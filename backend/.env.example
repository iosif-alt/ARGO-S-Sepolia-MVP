# Base Sepolia RPC. The public endpoint works for initial tests but is rate-limited.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Ethereum Sepolia is the current preferred public testnet for ARGO-S.
ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com
LOCALHOST_RPC_URL=http://127.0.0.1:8545
TRONGRID_API_URL=https://nile.trongrid.io
TRONGRID_API_KEY=
TRON_TUSDT_CONTRACT=TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf
TRON_TUSDT_DECIMALS=6
TRON_TREASURY_ADDRESS=TUYfr6A9jtEgoePyewjFKwspVXcx34A4XS
GOOGLE_CLIENT_ID=
GOOGLE_INVESTOR_EMAIL=
GOOGLE_MAKER_EMAIL=
GOOGLE_CHECKER_EMAIL=

# Use a dedicated TESTNET-ONLY wallet. Never put a production wallet key here.
DEPLOYER_PRIVATE_KEY=0xYOUR_TESTNET_ONLY_PRIVATE_KEY

# For the first deployment these may equal the deployer. Before external
# testing they should be separated and administrative ownership moved to Safe.
TOKEN_AGENT_ADDRESS=0xTOKEN_AGENT_ADDRESS
IDENTITY_ADMIN_ADDRESS=0xIDENTITY_ADMIN_ADDRESS
CLAIM_SIGNER_ADDRESS=0xCLAIM_SIGNER_ADDRESS

# Governance ownership should point to a testnet Safe before external testing.
GOVERNANCE_OWNER_ADDRESS=0xGOVERNANCE_OWNER_ADDRESS

# Maximum indivisible ARGOS units authorized for this deployment.
ARGO_AUTHORIZED_SUPPLY=60000000

# Comma-separated uint16 jurisdiction codes. Empty means default-deny for all countries.
# Populate only after the legal eligibility matrix has been approved.
ARGO_ALLOWED_COUNTRIES=
